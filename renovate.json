{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "gitAuthor": "Shark <shark@valentinus.dev>",
  "enabledManagers": [
    "dockerfile",
    "flux",
    "github-actions",
    "kubernetes",
    "nix",
    "custom.regex"
  ],
  "automerge": false,
  "flux": {
    "managerFilePatterns": ["/^flux-system\\/.*\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^flux-system\\/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^flux-system\\/sources\\.yaml$/"],
      "matchStrings": ["url: oci://code\\.forgejo\\.org/forgejo-helm/forgejo\\s+ref:\\s+# renovate: chart=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})"],
      "depNameTemplate": "forgejo",
      "packageNameTemplate": "code.forgejo.org/forgejo-helm/forgejo",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Never automerge Kubernetes and Helm dependencies",
      "matchManagers": ["flux", "kubernetes"],
      "automerge": false
    },
    {
      "description": "Flux controller images are upgraded together with the Flux CLI (flux install --export), not image by image",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["flux-system/gotk-components.yaml"],
      "enabled": false
    },
    {
      "description": "Renovate itself has thousands of releases; building release notes for a multi-major jump pegs a CPU for ~40 minutes on every run",
      "matchPackageNames": ["renovate/renovate"],
      "fetchChangeLogs": "off"
    },
    {
      "description": "Renovate regenerates gotk-components.yaml with the flux binary copied from this image, so the fluxcd/flux2 update stays empty until this one is merged",
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["ghcr.io/fluxcd/flux-cli"],
      "prBodyNotes": ["Merge this first: the fluxcd/flux2 (gotk-components.yaml) update is generated with this flux CLI and only produces changes once it runs the new version."]
    },
    {
      "description": "Delegate this digest-only OCI source to the version-aware custom manager; Flux ignores ref.tag when ref.digest is set",
      "matchManagers": ["flux"],
      "matchFileNames": ["flux-system/sources.yaml"],
      "matchPackageNames": ["code.forgejo.org/forgejo-helm/forgejo"],
      "enabled": false
    },
    {
      "description": "Only reviewed Forgejo 15 LTS chart mappings: 17.1.5=15.0.7, 17.3.1=15.0.10. Review appVersion and rendered image before extending this allowlist; chart major is not app major",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["flux-system/sources.yaml"],
      "matchPackageNames": ["code.forgejo.org/forgejo-helm/forgejo"],
      "allowedVersions": "/^(17\\.1\\.5|17\\.3\\.1)$/",
      "pinDigests": true,
      "automerge": false,
      "draftPR": true,
      "recreateWhen": "never"
    },
    {
      "description": "Hold Nextcloud for storage and application audit",
      "matchPackageNames": ["nextcloud", "nextcloud/*"],
      "automerge": false,
      "prCreation": "immediate",
      "labels": ["dependencies", "nextcloud", "hold-storage-audit"]
    }
  ]
}
